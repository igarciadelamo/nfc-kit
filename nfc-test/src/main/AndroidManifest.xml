<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />

    <application>
        <!--
            Debug-only entry point. android.permission.DUMP is required so only
            the adb shell (and other DUMP holders) can send the broadcast.
        -->
        <receiver
            android:name="dev.nfctest.NfcTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.nfctest.TAP" />
            </intent-filter>
        </receiver>

        <!--
            Debug-only cold-start trampoline. The adb shell starts it and it
            launches the destination Activity with the NFC Intent already set.
            DUMP keeps it reachable only from the shell and DUMP holders.
        -->
        <activity
            android:name="dev.nfctest.NfcTestLaunchActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Installs the activity tracker and the injectable reader at startup. -->
        <provider
            android:name="dev.nfctest.NfcTestInitProvider"
            android:authorities="${applicationId}.nfctest-init"
            android:exported="false"
            android:initOrder="1000" />
    </application>

</manifest>
