<?xml version="1.0" encoding="utf-8"?>
<!--
    Colourful modal shown whenever a tag is delivered. It lives inside the
    activity window (not a Dialog) so it never leaks across lifecycle changes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tag_modal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nfc_scrim"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/tag_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_modal_card"
        android:elevation="24dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_modal_header"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="@string/modal_kicker"
                android:textColor="@color/nfc_white_72"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tag_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/nfc_white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tag_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/nfc_white"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="@string/modal_uid_label"
                android:textColor="@color/nfc_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tag_uid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/nfc_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tag_records_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:textColor="@color/nfc_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tag_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:maxLines="3"
                android:textColor="@color/nfc_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tag_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/nfc_text_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/nfc_divider" />

            <Button
                android:id="@+id/tag_close"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/modal_close"
                android:textAllCaps="false"
                android:textColor="@color/nfc_success_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/modal_hint"
                android:textColor="@color/nfc_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
